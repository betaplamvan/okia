# Sao chép thành .env cho dev. Tên biến theo docs/02 — Môi trường.
ENV=development
DATABASE_URL=postgresql+asyncpg://okia:okia@localhost:5433/okia
REDIS_URL=redis://localhost:6380/0
JWT_SECRET=doi-chuoi-nay-trong-production-openssl-rand-hex-32  # >= 32 ký tự
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000             # thêm ,http://<ip-lan>:3000 để máy khác trong mạng chơi được

# Xác thực (docs/13)
COOKIE_SECURE=false                       # true khi chạy https (production)
API_BASE_URL=http://localhost:8000        # để dựng redirect_uri cho Google
GOOGLE_CLIENT_ID=                         # Google Cloud Console → OAuth client (Web); redirect URI: {API_BASE_URL}/auth/google/callback
GOOGLE_CLIENT_SECRET=
EMAIL_PROVIDER=resend                     # resend | console (test)
RESEND_API_KEY=                           # https://resend.com/api-keys
EMAIL_FROM=Ô Kìa <no-reply@okia.io.vn>    # tên miền đã xác minh trên Resend (DKIM/SPF)

# Ảnh người dùng tải lên → MinIO/S3 (docs/02). Để trống = giữ trong bộ nhớ (mất khi restart).
S3_ENDPOINT_URL=                          # https://minio.example.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=okia-bucket
S3_PUBLIC_URL=                            # https://minio.example.com/okia-bucket — sau khi chạy `uv run python -m scripts.s3_setup`

# Ủng hộ (docs/10 — Donate): tài khoản nhận hiện trên /donate (VietQR) + webhook
DONATE_BANK_BIN=970422
DONATE_BANK_NAME=MB Bank
DONATE_ACCOUNT_NO=
DONATE_ACCOUNT_NAME=
DONATE_KOFI_URL=
SEPAY_API_KEY=
KOFI_VERIFICATION_TOKEN=
